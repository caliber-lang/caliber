def classify (n: Int) -> Int =
    if n < 0 then
        print "negative"
        return 0
    else
        if n == 0 then
            print "zero"
            return 1
        else
            print "positive"
            return 2

def main =
    var a <- classify(-5)
    var b <- classify(0)
    var c <- classify(7)
    print a
    print b
    print c
